<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MovementHud</AssemblyName>
    <RootNamespace>MovementHud</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.357" />
    <Reference Include="SharpTimerAPI">
      <HintPath>lib/SharpTimerAPI/SharpTimerAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="MovementHud.Tests" />
  </ItemGroup>
</Project>
